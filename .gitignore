# secrets
.env

# data: only the README is committed
data/*
!data/README.md

# Model outputs ARE committed (results/<run>/responses.jsonl, summary.json, figures) so the
# team shares one set of responses and nobody pays to re-run them. Only local review images
# derived from the dataset stay out.
results/box_check/

# API failure audits are local diagnostics, not reusable responses
results/**/attempt_errors.jsonl

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# free mock runs are regenerated on demand
results/smoke_mock/
results/constraints_mock/
results/image_mock/

# error review pages embed dataset frames
results/error_review/

results/image_rationale_mock/
