# secrets
.env

# data: only the README is committed
data/*
!data/README.md

# Model outputs ARE committed (results/<id>_<run>/responses.jsonl, summary.json, figures) so the
# team shares one set of responses and nobody pays to re-run them. Only local review images
# derived from the dataset stay out.
results/box_check/

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# free mock runs are regenerated on demand (mock-only runs keep plain results/<run>/ folders, no run ID)
results/smoke_mock/
results/smoke_mock_text/

# error review pages embed dataset frames
results/error_review/

# per-session edit logs for the Stop hook (.claude/hooks/track_edits.sh)
.claude/hooks/state/
